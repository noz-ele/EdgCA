{
  "name": "@noz-ele/edgca",
  "version": "0.6.0",
  "description": "A small Cloudflare Workers-friendly toolkit for issuing and validating bounded self-managed CA chains.",
  "type": "module",
  "license": "MIT",
  "author": "NOZ-ELE",
  "homepage": "https://github.com/noz-ele/EdgCA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noz-ele/EdgCA.git"
  },
  "bugs": {
    "url": "https://github.com/noz-ele/EdgCA/issues"
  },
  "keywords": [
    "ca",
    "x509",
    "mtls",
    "client-certificate",
    "pki",
    "ecdsa",
    "p-256",
    "webcrypto",
    "cloudflare-workers",
    "edge"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pkcs12": {
      "types": "./dist/pkcs12.d.ts",
      "import": "./dist/pkcs12.js"
    },
    "./issuer": {
      "types": "./dist/issuer.d.ts",
      "import": "./dist/issuer.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "edgca": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "pretest:workers": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test:workers": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@types/node": "^25.7.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "fast-check": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.45.0"
  }
}
